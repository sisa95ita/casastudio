NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
DATABASE_URL=postgresql://casastudio:replace-me-local-postgres-password@localhost:5432/casastudio?schema=public
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=casastudio
KEYCLOAK_ISSUER=http://localhost:8080/realms/casastudio
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/casastudio/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=casastudio-api
KEYCLOAK_CLIENT_ID=casastudio-api
SWAGGER_ENABLED=true
LOG_LEVEL=debug
# AI_PROVIDER=openai
# OPENAI_API_KEY=replace-me-with-server-side-openai-api-key
# OPENAI_REASONING_MODEL=gpt-5.6-sol
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_SIZE=1536x1024
# OPENAI_IMAGE_FORMAT=png

# Application-owned AI proposal images (relative to the API working directory).
AI_ARTIFACT_STORAGE=filesystem
AI_ARTIFACT_DIRECTORY=.data/design-artifacts
AI_ARTIFACT_MAX_BYTES=20000000
