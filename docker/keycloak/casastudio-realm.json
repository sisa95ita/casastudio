{
  "realm": "casastudio",
  "enabled": true,
  "displayName": "CasaStudio",
  "displayNameHtml": "CasaStudio",
  "loginTheme": "casastudio",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "clients": [
    {
      "clientId": "casastudio-web",
      "name": "CasaStudio Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:8081/*",
        "${CASASTUDIO_WEB_LAN_ORIGIN}/*",
        "https://oauth.pstmn.io/v1/browser-callback"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:8081",
        "${CASASTUDIO_WEB_LAN_ORIGIN}"
      ],
      "protocolMappers": [
        {
          "name": "casastudio-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "casastudio-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "casastudio-api",
      "name": "CasaStudio API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CASASTUDIO_KEYCLOAK_API_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "protocolMappers": [
        {
          "name": "casastudio-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "casastudio-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "casastudio-api": [
        {
          "name": "casastudio-user",
          "description": "Development role for normal CasaStudio API access"
        },
        {
          "name": "casastudio-admin",
          "description": "Development role for administrative CasaStudio API diagnostics"
        }
      ]
    }
  },
  "users": [
    {
      "id": "8d62f7e2-0c2a-4f2a-a9cf-7f62c2f4e8f7",
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "CasaStudio",
      "lastName": "Demo",
      "email": "demo@casastudio.local",
      "credentials": [
        {
          "type": "password",
          "value": "${CASASTUDIO_KEYCLOAK_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "clientRoles": {
        "casastudio-api": [
          "casastudio-user"
        ]
      }
    }
  ]
}
