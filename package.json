{
  "name": "casastudio",
  "version": "0.2.0-SNAPSHOT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "turbo dev",
    "generate:schema": "pnpm --filter @casastudio/schema generate:schema",
    "api:dev": "pnpm --filter @casastudio/api dev",
    "api:build": "pnpm --filter @casastudio/api build",
    "api:test": "pnpm --filter @casastudio/api test",
    "api:lint": "pnpm --filter @casastudio/api lint",
    "web:dev": "pnpm --filter @casastudio/web dev",
    "web:build": "pnpm --filter @casastudio/web build",
    "web:test": "pnpm --filter @casastudio/web test",
    "web:lint": "pnpm --filter @casastudio/web lint",
    "e2e:infra:up": "docker compose up -d postgres keycloak",
    "e2e:infra:down": "docker compose stop postgres keycloak",
    "e2e:prepare": "pnpm db:migrate:deploy && pnpm db:seed",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "app:dev": "pnpm --parallel --filter @casastudio/api --filter @casastudio/web dev",
    "app:build": "pnpm --filter @casastudio/api build && pnpm --filter @casastudio/web build",
    "app:test": "pnpm --filter @casastudio/api test && pnpm --filter @casastudio/web test",
    "app:lint": "pnpm --filter @casastudio/api lint && pnpm --filter @casastudio/web lint",
    "db:generate": "pnpm --filter @casastudio/api db:generate",
    "db:validate": "pnpm --filter @casastudio/api db:validate",
    "db:migrate:dev": "pnpm --filter @casastudio/api db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @casastudio/api db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @casastudio/api db:migrate:status",
    "db:seed": "pnpm --filter @casastudio/api db:seed",
    "db:reset:dev": "pnpm --filter @casastudio/api db:reset",
    "docker:dev:up": "docker compose -f compose.yml -f compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f compose.yml -f compose.dev.yml down",
    "docker:test:up": "docker compose -f compose.yml -f compose.test.yml up --build --abort-on-container-exit --exit-code-from api-test api-test",
    "docker:test:down": "docker compose -f compose.yml -f compose.test.yml down --volumes",
    "docker:build": "node tools/build-local-images.mjs",
    "jenkins:up": "docker compose -f compose.jenkins.yml up -d --build",
    "jenkins:down": "docker compose -f compose.jenkins.yml down",
    "jenkins:logs": "docker compose -f compose.jenkins.yml logs -f",
    "jenkins:config": "docker compose -f compose.jenkins.yml config",
    "version:declared": "node tools/build-version.mjs declared",
    "version:build": "node tools/build-version.mjs resolve",
    "version:test": "node --test tools/*.test.mjs",
    "build": "turbo build",
    "build:ci": "turbo build --concurrency=1",
    "lint": "turbo lint",
    "lint:ci": "turbo lint --concurrency=1",
    "test": "pnpm version:test && turbo test",
    "test:ci": "pnpm version:test && turbo test --concurrency=1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.2.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.0"
  }
}
